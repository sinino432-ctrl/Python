x = '오늘 날씨는'          # 문자열 변수 x에 '오늘 날씨는' 저장
print(len(x))             # 문자열의 길이 출력 (총 글자 수)
print(x)                  # 문자열 전체 출력
print(x[:3])              # 문자열의 처음부터 3번째 글자까지 출력 ('오늘 ')
print(x[3:6])             # 문자열의 4번째부터 6번째 글자까지 출력 ('날씨')
print(x[-3])              # 문자열의 뒤에서 3번째 글자 출력 ('씨')
print(x[-3:])             # 문자열의 뒤에서 3번째 글자부터 끝까지 출력 ('씨는')
