    print('---------------------------------------------')
    print(i+1, '번째 응시자님:')
    if x > 80:
        print('축하합니다~ 합격입니다')
        print('다음주부터 출근하시면 됩니다.')
    elif x > 60:
        print('2차 면접시험 대상자 입니다.')
        print('시험 날짜를 알려드립니다.')
    else:
        print('불합격입니다.')
