a = 3
b = 90
small_list = [100,200]
x = [1,2,a,a*10,b,small_list,'김연아']

print(len(x))   # 리스트의 항목 수 → 7
print(x[1])     # 두 번째(인덱스 1) 항목 → 2
print(x[:3])    # 네 번째(인덱스 3) 미만까지 → [1, 2, 3]
print(x[3:6])   # 네 번째(인덱스 3) 이상 ~ 7번째(인덱스 6) 미만 → [30, 90, [100, 200]]
print(x[-3])    # 뒤에서 세 번째(인덱스 -3) 항목 → 90
print(x[-3:])   # 뒤에서 세 번째(인덱스 -3) 이후 → [90, [100, 200], '김연아']
